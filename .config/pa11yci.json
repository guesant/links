{
  "defaults": {
    "concurrency": 1,
    "runners": ["axe", "htmlcs"],
    "standard": "WCAG2AA",
    "timeout": 30000,
    "wait": 1000,
    "threshold": 0,
    "viewport": { "width": 1280, "height": 1024 },
    "chromeLaunchConfig": {
      "args": ["--no-sandbox", "--disable-dev-shm-usage"],
      "executablePath": "/usr/bin/chromium"
    }
  }
}
